          ]
        }
      }
    },
    "ConsumerEventSourceMappingSQSOrdersQueue": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "DependsOn": "IamRoleLambdaExecution",
      "Properties": {
        "BatchSize": 5,
        "EventSourceArn": {
          "Fn::GetAtt": [
            "OrdersQueue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Fn::GetAtt": [
            "ConsumerLambdaFunction",
            "Arn"
          ]
        },
        "Enabled": true
      }
    }
